# Copy to .env, which is ignored. Use scripts/setup_env.py to generate local secrets.
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_API_URL=https://api.slmartinez.org
PUBLIC_ADMIN_URL=https://admin.slmartinez.org
# Native development. Docker Compose overrides this to /data/loyalty.db.
DATABASE_URL=sqlite:///./loyalty.db
PAN_HASH_SECRET=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_HOURS=12
ASSETS_DIR=/data/assets
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.org.slmartinez.loyalty
APPLE_CERT_PATH=/certs/pass.p12
APPLE_CERT_PASSWORD=
APPLE_WWDR_CERT_PATH=/certs/wwdr.pem
APPLE_WEBSERVICE_URL=https://api.slmartinez.org
GOOGLE_ISSUER_ID=
GOOGLE_SA_JSON=/certs/google-sa.json

# Standalone deployment only: full SHA of a published commit containing start_api.sh.
# SOURCE_REF=
# DATA_DIR=./data
# CERTS_DIR=./data/certs
# API_PORT=8000
# ADMIN_PORT=8080

# Private GitHub repository: read-only Contents token, only used by source download.
GITHUB_TOKEN=
